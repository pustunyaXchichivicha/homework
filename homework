public class Main {
    public static void main(String[] args) {
        // Задание 1: Переменные и вывод
        int myInt = 10;
        byte myByte = 5;
        short myShort = 100;
        long myLong = 999999L;
        float myFloat = 5.5f;
        double myDouble = 10.55;

        System.out.println("Значение переменной myInt с типом int равно " + myInt);
        System.out.println("Значение переменной myByte с типом byte равно " + myByte);
        System.out.println("Значение переменной myShort с типом short равно " + myShort);
        System.out.println("Значение переменной myLong с типом long равно " + myLong);
        System.out.println("Значение переменной myFloat с типом float равно " + myFloat);
        System.out.println("Значение переменной myDouble с типом double равно " + myDouble);

        // Задание 2: Спортзавтрак
        int grams = (5 * 80) + (2 * 105) + (2 * 100) + (4 * 70);
        double kilograms = grams / 1000.0; // Делим на 1000.0, чтобы получить дробь

        System.out.println("Вес в граммах: " + grams);
        System.out.println("Вес в килограммах: " + kilograms);

        // Задание 3: Зарплата (считаем прибавку напрямую)
        int mashaBonus = 67760 / 10; // 10% от зарплаты
        int denisBonus = 83690 / 10;
        int kristinaBonus = 76230 / 10;

        System.out.println("Маша теперь получает " + (67760 + mashaBonus) + " рублей. Годовой доход вырос на " + (mashaBonus * 12) + " рублей.");
        System.out.println("Денис теперь получает " + (83690 + denisBonus) + " рублей. Годовой доход вырос на " + (denisBonus * 12) + " рублей.");
        System.out.println("Кристина теперь получает " + (76230 + kristinaBonus) + " рублей. Годовой доход вырос на " + (kristinaBonus * 12) + " рублей.");
    }
}
